{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "配置驱动的组织架构与人力管理可视化平台：一份 yaml/json/toml 渲染出领域树、人物卡、人力缺口与借调关系，支持导出 drawio 与 PNG",
  "keywords": [
    "org-chart",
    "organization",
    "visualization",
    "headcount",
    "drawio",
    "nextjs",
    "config-driven"
  ],
  "homepage": "https://github.com/jiusanzhou/atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiusanzhou/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/jiusanzhou/atlas/issues"
  },
  "author": "Zoe (jiusanzhou)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@iarna/toml": "^2.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "framer-motion": "^13.1.1",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "puppeteer": "^25.9.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.29.2",
  "puppeteer": {
    "skipDownload": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
